{
  "version": 8,

  "name": "north-dakota-street-address-lookup",
  "id": "north-dakota-street-address-lookup",
  "metadata": {},

  "sources": {
    "google_satellite": {
      "type": "raster",
      "tiles": [
        "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}"
      ],
      "tileSize": 256,
      "attribution": "<a target='_blank' href='https://maps.google.com/'>Google Maps</a>"
    }
  },

  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#404040"
      }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "google_satellite",
      "minzoom": 10,
      "maxzoom": 24,
      "paint": {
        "raster-opacity": {
          "stops": [[10, 0], [10.5, 1], [24, 1]]
        }
      }
    },
    {
      "id": "counties",
      "type": "line",
      "source": "counties",
      "paint": {
        "line-color": "#00baa7",
        "line-width": 2,
        "line-opacity": {
          "stops": [[1, 1], [5, 1], [13, 0]]
        }
      }
    },
    {
      "id": "reservations",
      "type": "line",
      "source": "reservations",
      "paint": {
        "line-color": "#00baa7",
        "line-width": 2,
        "line-opacity": {
          "stops": [[1, 1], [5, 1], [13, 0]]
        }
      }
    },
    {
      "id": "reservations-fill",
      "type": "fill",
      "source": "reservations",
      "paint": {
        "fill-color": "#00baa7",
        "fill-opacity": {
          "stops": [[1, 1], [5, 1], [13, 0]]
        }
      }
    },
    {
      "id": "counties-names",
      "type": "symbol",
      "source": "counties",
      "maxzoom": 12,
      "layout": {
        "text-font": ["Noto Sans Bold"],
        "text-size": {
          "base": 1.2,
          "stops": [[7, 14], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#00baa7",
        "text-opacity": {
          "stops": [[1, 1], [5, 1], [13, 0]]
        }
      }
    },
    {
      "id": "reservation-names",
      "type": "symbol",
      "source": "reservations",
      "maxzoom": 12,
      "layout": {
        "text-font": ["Noto Sans Bold"],
        "text-size": {
          "base": 1.2,
          "stops": [[7, 14], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 7
      },
      "paint": {
        "text-color": "white",
        "text-opacity": {
          "stops": [[1, 1], [5, 1], [13, 0]]
        }
      }
    },

    {
      "id": "highway-secondary-tertiary",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "secondary"], ["==", "draw", 1]],
      "minzoom": 8.5,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": {
          "base": 0.5,
          "stops": [[8.5, 0], [9.5, 0.5], [20, 0.5]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[6.5, 1], [8, 1.5], [20, 13]]
        }
      }
    },
    {
      "id": "highway-primary",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "primary"], ["==", "draw", 1]],
      "minzoom": 8.5,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[8.5, 1], [9, 1.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-trunk",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "trunk"], ["==", "draw", 1]],
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[4, 1], [7, 1.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-motorway",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "motorway"], ["==", "draw", 1]],
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[4, 1], [7, 1.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-name-major",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "primary", "secondary", "tertiary", "motorway", "trunk"], ["!=", "name", ""]],
      "minzoom": 12.2,
      "layout": {
        "text-size": {
          "base": 1,
          "stops": [[13, 12], [14, 13]]
        },
        "text-font": ["Noto Sans Regular"],
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "black",
        "text-halo-color": "white",
        "text-halo-blur": 0.5,
        "text-halo-width": 2
      }
    },
    {
      "id": "highway-shield",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_length", 0], ["<=", "ref_length", 7], ["in", "ref_prefix", "CR", "BIA", "FS", "PTH", "PR", "TR", "CH"]],
      "minzoom": 10.5,
      "layout": {
        "text-size": 10,
        "icon-image": "road_{ref_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_prefix} {ref_rest}"
      },
      "paint": {
        "text-color": "black"
      }
    },
    {
      "id": "highway-shield-us-interstate",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_rest_length", 0], ["<=", "ref_rest_length", 3], ["in", "ref_prefix", "I"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-interstate_{ref_rest_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[7, "point"], [7, "line"], [8, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_rest}"
      },
      "paint": {
        "text-color": "black"
      }
    },
    {
      "id": "highway-shield-us-other",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_rest_length", 0], ["<=", "ref_rest_length", 3], ["in", "ref_prefix", "US"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-highway_{ref_rest_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_rest}"
      },
      "paint": {
        "text-color": "black"
      }
    },
    {
      "id": "highway-shield-us-other-2",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_length", 0], ["<=", "ref_length", 6], ["in", "ref_prefix", "ND", "SD", "MT", "MN"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-state_{ref_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_prefix} {ref_rest}"
      },
      "paint": {
        "text-color": "black"
      }
    },

    {
      "id": "place-11.9",
      "type": "symbol",
      "source": "places",
      "filter": [">=", "minzoom", 11.9],
      "minzoom": 11.9,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[7, 15], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "white",
        "text-halo-width": 1.2,
        "text-halo-color": "black"
      }
    },
    {
      "id": "place-8",
      "type": "symbol",
      "source": "places",
      "filter": ["all", [">=", "minzoom", 8], ["<", "minzoom", 11.9]],
      "minzoom": 8,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[7, 15], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "white",
        "text-halo-width": 1.2,
        "text-halo-color": "black"
      }
    },
    {
      "id": "place-7",
      "type": "symbol",
      "source": "places",
      "filter": ["all", [">=", "minzoom", 7], ["<", "minzoom", 8]],
      "minzoom": 7,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[7, 15], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "white",
        "text-halo-width": 1.2,
        "text-halo-color": "black"
      }
    },
    {
      "id": "place-5",
      "type": "symbol",
      "source": "places",
      "filter": ["<", "minzoom", 7],
      "minzoom": 5,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[5, 15], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "white",
        "text-halo-width": 1.2,
        "text-halo-color": "black"
      }
    }

  ]
}
